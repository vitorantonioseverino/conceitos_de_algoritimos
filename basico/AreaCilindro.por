programa
{
	
	funcao inicio()
	{
		inteiro altura, area, volume  
		escreva("Digite a altura: ")
		leia(altura)
		
		escreva("Digite a area: ")
		leia(area)
		
		volume = altura * area 
		escreva("valor é: ", volume) 
		
		
	}
}
