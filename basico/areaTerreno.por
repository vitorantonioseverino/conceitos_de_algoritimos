programa
{
	
	funcao inicio()
	{
		inteiro Largura , altura , total 
		
		escreva("Digite a largura do terreno: ")
		leia(Largura) 
		
		escreva("Digite a altura do terreno: ")
		leia(altura) 
		
		total  = Largura * altura  
		escreva("area do terreno e:", total) 	
	}
}
