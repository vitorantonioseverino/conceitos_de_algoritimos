programa
{
	
	funcao inicio()
	{
		escreva("Digite seu saldo atual: ")
		inteiro saldoatual, valorcompra, saldoposcompra
			leia(saldoatual)
		
		escreva("Digite o valor da compra:")
			leia(valorcompra) 
				saldoposcompra = (saldoatual - valorcompra)
		 
		escreva("seu saldo atual é:", saldoposcompra) 
		
	}
}  
